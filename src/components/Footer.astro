---
import Socials from "./Socials.astro";
import { getPosts } from "../utils/posts";

const count = (await getPosts()).length;
const year = new Date().getFullYear();
---

<footer>
  <div class="container"><hr aria-hidden="true" /></div>
  <div class="footer-wrapper">
    <Socials centered />
    <div class="copyright">
      <span>Copyright &copy; {year}</span>
      <span class="sep">&nbsp;|&nbsp;</span>
      <span>All rights reserved</span>
      <span class="sep">&nbsp;|&nbsp;</span>
      <a href="/posts/" class="link-hover">{count} posts</a>
    </div>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    margin-top: auto;
  }
  hr {
    border-color: var(--border);
  }
  .footer-wrapper {
    max-width: 48rem;
    margin-inline: auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .copyright {
    display: flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
    margin-block: 0.5rem;
  }
  .sep {
    display: none;
  }
  @media (min-width: 640px) {
    .footer-wrapper {
      flex-direction: row-reverse;
      justify-content: space-between;
      padding-block: 1rem;
    }
    .copyright {
      flex-direction: row;
      margin-block: 0;
    }
    .sep {
      display: inline;
    }
  }
</style>
