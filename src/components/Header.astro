---
import { NAV, SITE } from "../config";

const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith("/") && path.startsWith(href);
---

<header>
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="nav-container">
    <div class="top-nav-wrap">
      <a href="/" class="logo">{SITE.title}</a>
      <nav id="nav-menu">
        <button class="hamburger" aria-label="Open Menu" aria-expanded="false" aria-controls="menu-items">
          <svg class="icon-stroke" viewBox="0 0 24 24" stroke-width="1.5">
            <line x1="7" y1="12" x2="21" y2="12" class="line"></line>
            <line x1="3" y1="6" x2="21" y2="6" class="line"></line>
            <line x1="12" y1="18" x2="21" y2="18" class="line"></line>
            <line x1="18" y1="6" x2="6" y2="18" class="close"></line>
            <line x1="6" y1="6" x2="18" y2="18" class="close"></line>
          </svg>
        </button>
        <ul id="menu-items">
          {
            NAV.map(({ href, label }) => (
              <li>
                <a href={href} class:list={{ active: isActive(href) }}>{label}</a>
              </li>
            ))
          }
          <li>
            <a href="/search/" class:list={["icon-btn", { active: isActive("/search/") }]} title="Search" aria-label="search">
              <svg class="icon" viewBox="0 0 24 24"
                ><path
                  d="M19.023 16.977a35.13 35.13 0 0 1-1.367-1.384c-.372-.378-.596-.653-.596-.653l-2.8-1.337A6.962 6.962 0 0 0 16 9c0-3.859-3.14-7-7-7S2 5.141 2 9s3.14 7 7 7c1.763 0 3.37-.66 4.603-1.739l1.337 2.8s.275.224.653.596c.387.363.896.854 1.384 1.367l1.358 1.392.604.646 2.121-2.121-.646-.604c-.379-.372-.885-.866-1.391-1.36zM9 14c-2.757 0-5-2.243-5-5s2.243-5 5-5 5 2.243 5 5-2.243 5-5 5z"
                ></path></svg
              >
            </a>
          </li>
          <li>
            <button id="theme-btn" class="icon-btn" title="Toggles light & dark" aria-label="auto" aria-live="polite">
              <svg id="moon-svg" class="icon" viewBox="0 0 24 24"
                ><path
                  d="M20.742 13.045a8.088 8.088 0 0 1-2.077.271c-2.135 0-4.14-.83-5.646-2.336a8.025 8.025 0 0 1-2.064-7.723A1 1 0 0 0 9.73 2.034a10.014 10.014 0 0 0-4.489 2.582c-3.898 3.898-3.898 10.243 0 14.143a9.937 9.937 0 0 0 7.072 2.93 9.93 9.93 0 0 0 7.07-2.929 10.007 10.007 0 0 0 2.583-4.491 1.001 1.001 0 0 0-1.224-1.224zm-2.772 4.301a7.947 7.947 0 0 1-5.656 2.343 7.953 7.953 0 0 1-5.658-2.344c-3.118-3.119-3.118-8.195 0-11.314a7.923 7.923 0 0 1 2.06-1.483 10.027 10.027 0 0 0 2.89 7.848 9.972 9.972 0 0 0 7.848 2.891 8.036 8.036 0 0 1-1.484 2.059z"
                ></path></svg
              >
              <svg id="sun-svg" class="icon" viewBox="0 0 24 24"
                ><path
                  d="M6.993 12c0 2.761 2.246 5.007 5.007 5.007s5.007-2.246 5.007-5.007S14.761 6.993 12 6.993 6.993 9.239 6.993 12zM12 8.993c1.658 0 3.007 1.349 3.007 3.007S13.658 15.007 12 15.007 8.993 13.658 8.993 12 10.342 8.993 12 8.993zM10.998 19h2v3h-2zm0-17h2v3h-2zm-9 9h3v2h-3zm17 0h3v2h-3zM4.219 18.363l2.12-2.122 1.415 1.414-2.12 2.122zM16.24 6.344l2.122-2.122 1.414 1.414-2.122 2.122zM6.342 7.759 4.22 5.637l1.415-1.414 2.12 2.122zm13.434 10.605-1.414 1.414-2.122-2.122 1.414-1.414z"
                ></path></svg
              >
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <div class="container"><hr aria-hidden="true" /></div>
</header>

<style>
  #skip-to-content {
    position: absolute;
    left: -9999px;
    top: 1rem;
    z-index: 50;
    background: var(--accent);
    color: var(--bg);
    padding: 0.5rem 1rem;
  }
  #skip-to-content:focus {
    left: 1rem;
  }
  .nav-container {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  .top-nav-wrap {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-block: 2rem;
  }
  @media (min-width: 640px) {
    .top-nav-wrap {
      align-items: center;
      padding-block: 1.5rem;
    }
  }
  .logo {
    position: absolute;
    padding-block: 0.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .logo {
      position: static;
      font-size: 1.5rem;
      font-weight: 400;
    }
  }
  nav {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }
  @media (min-width: 640px) {
    nav {
      flex-direction: row;
      justify-content: flex-end;
      padding-block: 0;
    }
  }
  .hamburger {
    align-self: flex-end;
    padding: 0.5rem;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  @media (min-width: 640px) {
    .hamburger {
      display: none;
    }
  }
  .hamburger .close {
    display: none;
  }
  .hamburger[aria-expanded="true"] .close {
    display: block;
  }
  .hamburger[aria-expanded="true"] .line {
    display: none;
  }
  #menu-items {
    display: none;
    margin-top: 1rem;
    width: 11rem;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem 0.5rem;
  }
  #menu-items.open {
    display: grid;
  }
  #menu-items li {
    justify-self: center;
  }
  @media (min-width: 640px) {
    #menu-items,
    #menu-items.open {
      display: flex;
      margin-top: 0;
      width: auto;
      gap: 0 1.25rem;
      align-items: center;
    }
  }
  #menu-items a {
    display: block;
    padding: 0.5rem 1rem;
    font-weight: 500;
    font-size: 1rem;
  }
  @media (min-width: 640px) {
    #menu-items a {
      padding: 0.25rem 0.5rem;
    }
  }
  #menu-items a:hover {
    color: var(--accent);
  }
  #menu-items a.active {
    text-decoration: underline wavy;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  #menu-items a.icon-btn,
  #menu-items button.icon-btn {
    display: flex;
    padding: 0.5rem;
  }
  #menu-items a.icon-btn.active {
    color: var(--accent);
  }
  .icon-btn svg {
    transition: fill 0.15s;
  }
  .icon-btn:hover svg {
    fill: var(--accent);
  }
  #theme-btn {
    background: none;
    color: inherit;
    cursor: pointer;
  }
  #moon-svg {
    display: inline-block;
  }
  #sun-svg {
    display: none;
  }
  :global(html[data-theme="dark"]) #moon-svg {
    display: none;
  }
  :global(html[data-theme="dark"]) #sun-svg {
    display: inline-block;
  }
  hr {
    border-color: var(--border);
  }
</style>

<script>
  function initHeader() {
    const btn = document.querySelector<HTMLButtonElement>(".hamburger");
    const menu = document.querySelector("#menu-items");
    btn?.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      btn.setAttribute("aria-label", open ? "Open Menu" : "Close Menu");
      menu?.classList.toggle("open", !open);
    });

    const w = window as unknown as { applyTheme: (t: string) => void; getTheme: () => string };
    w.applyTheme(w.getTheme());
    document.querySelector("#theme-btn")?.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("theme", next);
      } catch (_) {}
      w.applyTheme(next);
    });
  }
  document.addEventListener("astro:page-load", initHeader);
</script>
