---
import { SOCIALS, SITE } from "../config";

interface Props {
  centered?: boolean;
}
const { centered = false } = Astro.props;

const paths: Record<string, string> = {
  github:
    '<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/>',
  linkedin:
    '<rect x="4" y="4" width="16" height="16" rx="2"/><line x1="8" y1="11" x2="8" y2="16"/><line x1="8" y1="8" x2="8" y2="8.01"/><line x1="12" y1="16" x2="12" y2="11"/><path d="M16 16v-3a2 2 0 0 0 -4 0"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
};
---

<div class:list={["social-icons", { centered }]}>
  {
    SOCIALS.map((s) => (
      <a
        href={s.href}
        class="social-link"
        title={`${SITE.author} on ${s.title}`}
        target={s.href.startsWith("http") ? "_blank" : undefined}
        rel="noopener noreferrer"
      >
        <svg class="icon-stroke" viewBox="0 0 24 24" set:html={paths[s.name]} />
        <span class="sr-only">{s.title}</span>
      </a>
    ))
  }
</div>

<style>
  .social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .social-icons.centered {
    justify-content: center;
  }
  .social-link {
    padding: 0.25rem;
  }
  .social-link svg {
    transition: stroke 0.15s;
  }
  .social-link:hover svg {
    stroke: var(--accent);
  }
</style>
